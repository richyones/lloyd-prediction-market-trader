# ── Lloyd Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All variables are prefixed with LLOYD_ to avoid collisions.

# ── Polymarket (read-only in Stage 1, no credentials needed) ──
# LLOYD_POLYMARKET_WALLET_KEY=
# LLOYD_POLYMARKET_CLOB_KEY=
# LLOYD_POLYMARKET_CLOB_SECRET=
# LLOYD_POLYMARKET_CLOB_PASSPHRASE=

# ── Kalshi ──
# LLOYD_KALSHI_API_KEY_ID=
# LLOYD_KALSHI_RSA_KEY_PATH=./kalshi_private_key.pem
# LLOYD_KALSHI_RSA_KEY_CONTENT=  # Paste full PEM content here for cloud deployments (alternative to key path)
LLOYD_KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# ── Scanner Thresholds ──
LLOYD_MIN_VOLUME=10000
LLOYD_MIN_LIQUIDITY=1000
LLOYD_MIN_DAYS_TO_RESOLUTION=7
LLOYD_MAX_DAYS_TO_RESOLUTION=90

# ── Scheduler ──
LLOYD_SCAN_INTERVAL_MINUTES=30

# ── Health Check / Autotriage Defaults (lloyd_healthcheck.py + GitHub Actions) ──
# LLOYD_BASE_URL=https://your-app.up.railway.app  (domain only, no /health suffix)
# SLACK_WEBHOOK_URL=   # required for GitHub Action notifications (repo secret)
# TELEGRAM_BOT_TOKEN= / TELEGRAM_CHAT_ID=  (optional)
LLOYD_ENVIRONMENT=production
# On Railway, Lloyd binds to PORT automatically unless you set LLOYD_HEALTH_CHECK_PORT.
# LLOYD_KALSHI_RESOLUTION_BASE_URL=https://demo-api.kalshi.co
MAX_COST_PER_CYCLE_USD=2.0
PIPELINE_STUCK_HOURS=4
SCAN_DEAD_HOURS=6
RESOLVER_LOOKBACK_DAYS=3
RESOLVER_HIGH_COUNT=5
CYCLE_COST_HIGH_USD=3.0
CYCLE_COST_CRITICAL_USD=5.0
DAILY_COST_HIGH_USD=20.0
DAILY_COST_CRITICAL_USD=35.0
DAILY_COST_WARN_MULTIPLIER=1.25
DAILY_COST_HIGH_MULTIPLIER=1.5
DAILY_COST_CRITICAL_MULTIPLIER=2.0
API_DATA_FETCH_ATTEMPTS=2
API_DATA_RETRY_BACKOFF_SECONDS=2.0

# ── Database & Logging ──
LLOYD_DATABASE_PATH=./lloyd.db
LLOYD_LOG_LEVEL=INFO

# ── LLM API Keys ──
LLOYD_OPENAI_API_KEY=
LLOYD_ANTHROPIC_API_KEY=
LLOYD_GOOGLE_AI_API_KEY=

# ── Model Selection ──
# LLOYD_GEMINI_MODEL=gemini-2.5-flash
# LLOYD_GPT5_MODEL=gpt-4o
# LLOYD_CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Ensemble Calibration ──
# LLOYD_BUY_YES_ALPHA=0.15        # Lower alpha keeps buy_yes closer to market price
# LLOYD_MARKET_CONDITIONED_ALPHA=0.30  # Alpha for buy_no and no_trade
